# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turno?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/turno?schema=public"

# Servidor
PORT=4000
NODE_ENV=development

# Autenticación
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Reglas de negocio
MAX_PELUQUEROS_POR_NEGOCIO=5
FIANZA_RESERVA_USD=2.00

# Pasarela de pagos: mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# CORS (origen del frontend)
FRONTEND_ORIGIN="http://localhost:5173"

# --- Añadidos ---
RESERVA_HOLD_MINUTOS=15
STRIPE_PRICE_SAAS=""
APP_URL="http://localhost:5173"
UPLOAD_DIR="uploads"

# --- Features ---
EMAIL_TRANSPORT=dev   # dev (loguea) | smtp
EMAIL_FROM="Turno <no-reply@turno.app>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
CANCELACION_HORAS_REEMBOLSO=24
REFRESH_TOKEN_DIAS=30
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# Login con Google (Google Identity Services). Vacío = botón desactivado.
# Client ID del OAuth Client (Web) creado en Google Cloud Console.
GOOGLE_CLIENT_ID=""
