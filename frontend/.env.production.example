# Variables de build del frontend (Cloudflare Pages / Vercel / Netlify).
# URL pública del backend en Railway (sin barra final).
VITE_API_URL=https://turno-api.up.railway.app

# Login con Google: Client ID del "OAuth Client (Web)" de Google Cloud Console.
# Debe coincidir con el GOOGLE_CLIENT_ID del backend. Vacío = botón desactivado.
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
