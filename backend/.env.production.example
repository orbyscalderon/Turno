# Plantilla de variables para PRODUCCIÓN. Copia a tu proveedor (Render/Railway/VPS) como secrets.

# Base de datos gestionada.
# Supabase: DATABASE_URL = conexión "Transaction pooler" (puerto 6543) + ?pgbouncer=true
#           DIRECT_URL   = conexión "Session/Direct" (puerto 5432), para migraciones.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-region.pooler.supabase.com:5432/postgres"

NODE_ENV=production
PORT=4000

# Secreto largo y aleatorio (genera con: openssl rand -base64 48)
JWT_SECRET="CAMBIA-ESTO"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_DIAS=30

# Origen del frontend en producción (para CORS) y URL pública de la app
FRONTEND_ORIGIN="https://tudominio.com"
APP_URL="https://tudominio.com"

# Reglas de negocio
MAX_PELUQUEROS_POR_NEGOCIO=5
FIANZA_RESERVA_USD=2.00
# Comisión de la plataforma sobre la fianza (resto al negocio vía Stripe Connect).
FIANZA_COMISION_USD=0.50
# Calendario de depósitos a los negocios: daily | weekly | monthly. Anchor = día del mes (monthly).
STRIPE_PAYOUT_INTERVAL=monthly
STRIPE_PAYOUT_ANCHOR=1
# Comisión que cobra Stripe (para calcular el reparto real de la fianza).
STRIPE_FEE_PCT=2.9
STRIPE_FEE_FIJO=0.30
# Quién asume la comisión de Stripe: negocio | plataforma | compartido (50/50).
FEE_STRIPE_REPARTO=compartido
RESERVA_HOLD_MINUTOS=15
CANCELACION_HORAS_REEMBOLSO=24

# --- Pagos (Stripe en vivo) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Precios recurrentes en Stripe (crea 2 productos con precio mensual y anual cada uno):
STRIPE_PRICE_BASICO_MENSUAL="price_..."   # Básico $25/mes
STRIPE_PRICE_BASICO_ANUAL="price_..."     # Básico $250/año
STRIPE_PRICE_PRO_MENSUAL="price_..."      # Pro $50/mes
STRIPE_PRICE_PRO_ANUAL="price_..."        # Pro $500/año

# --- Pagos (PayPal, opcional) ---
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# --- Email (SMTP real: SendGrid/SES/Mailgun/Postmark) ---
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Turno <no-reply@tudominio.com>"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="TU_API_KEY"

# --- Almacenamiento de imágenes ---
# local = disco (solo si tienes volumen persistente). s3 = Backblaze B2 / Cloudflare R2.
STORAGE_PROVIDER=s3
UPLOAD_DIR="uploads"
# Backblaze B2 (S3-compatible). En B2: Application Key -> keyID/applicationKey.
S3_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
S3_REGION="us-west-004"
S3_BUCKET="turno-imagenes"
S3_ACCESS_KEY_ID="tu-keyID"
S3_SECRET_ACCESS_KEY="tu-applicationKey"
# Dominio del CDN (Cloudflare) delante del bucket; si vacío, usa el endpoint del bucket.
S3_PUBLIC_URL="https://cdn.tudominio.com"

# --- Primer superadmin (para: npm run bootstrap:admin) ---
SUPERADMIN_EMAIL="admin@tudominio.com"
SUPERADMIN_PASSWORD="CAMBIA-ESTO-min-10-chars"
SUPERADMIN_NOMBRE="Administrador"

# --- WhatsApp ---
# deeplink = enlace wa.me (gratis, el cliente pulsa). cloud = envío automático (Meta Cloud API).
WHATSAPP_PROVIDER=deeplink
# Para cloud (WhatsApp Cloud API de Meta):
WHATSAPP_TOKEN=""          # token permanente del System User de Meta
WHATSAPP_PHONE_ID=""       # Phone Number ID del número de WhatsApp Business
WHATSAPP_TEMPLATE=""       # nombre de la plantilla aprobada (5 variables: profesional, servicio, fecha, hora, código)
WHATSAPP_LANG="es"

# --- Observabilidad (opcional) ---
SENTRY_DSN=""

# NOTA: en NODE_ENV=production el backend NO arranca si el JWT_SECRET es débil/de dev,
# si falta STRIPE_*/SMTP_* cuando se activan, o si FRONTEND_ORIGIN apunta a localhost.

# --- Empresa operadora (CAMBIAR por los datos reales) ---
COMPANY_NAME="OC HOLDING GROUP LLC"
COMPANY_SUPPORT_EMAIL="soporte@tudominio.com"
