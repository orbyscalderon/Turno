{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    // Los tests de Vitest corren en Node y leen ficheros (p. ej. el diccionario
    // de i18n), así que necesitan sus tipos. Al navegador no llega nada de esto.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"]
}
