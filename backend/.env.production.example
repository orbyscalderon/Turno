####################################################################
#  TURNO — BACKEND · PLANTILLA DE PRODUCCIÓN
#
#  Copia a `.env.production` (o pega estas variables en el panel de
#  Render / Railway / Fly) y RELLENA todo lo que está vacío.
#
#  El backend se NIEGA A ARRANCAR en producción si:
#    · JWT_SECRET es débil o el de desarrollo
#    · FRONTEND_ORIGIN / APP_URL no llevan https:// (o apuntan a localhost)
#    · PAYMENT_PROVIDER no es una pasarela real
#    · EMAIL_TRANSPORT no es smtp
#    · faltan los secretos de los webhooks de Stripe
#  (Para un STAGING puedes relajar los dos últimos con PERMITIR_MODO_DEMO=true.)
####################################################################

NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------- #
# BASE DE DATOS
# ---------------------------------------------------------------- #
# App: conexión POOLED (Supabase/Neon: puerto 6543).
DATABASE_URL=""
# Migraciones: conexión DIRECTA (puerto 5432).
DIRECT_URL=""

# ---------------------------------------------------------------- #
# DOMINIOS (con https:// SIEMPRE)
# ---------------------------------------------------------------- #
# OJO: Render/Railway exponen el host SIN esquema. Si pegas solo el host,
# CORS falla y los enlaces de verificación y de reset llegan roto al email.
FRONTEND_ORIGIN="https://tudominio.com"
APP_URL="https://tudominio.com"

# ---------------------------------------------------------------- #
# SESIONES
# ---------------------------------------------------------------- #
# Genera uno único:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_DIAS=30

# ---------------------------------------------------------------- #
# OPERATIVA DE CITAS
# ---------------------------------------------------------------- #
TIMEZONE_DEFECTO="Europe/Madrid"
RESERVA_HOLD_MINUTOS=15
CANCELACION_HORAS_REEMBOLSO=24
ANTELACION_MINIMA_HORAS=1
HORIZONTE_RESERVA_DIAS=90
MAX_RESERVAS_PENDIENTES_POR_CLIENTE=3
# En producción: true (evita reservas de cuentas falsas).
EXIGIR_EMAIL_VERIFICADO=true
RECORDATORIO_CORTO_HORAS=3
MAX_PELUQUEROS_POR_NEGOCIO=5

# ---------------------------------------------------------------- #
# DINERO
# ---------------------------------------------------------------- #
FIANZA_RESERVA_USD=2
FIANZA_COMISION_USD=0.5
STRIPE_FEE_PCT=2.9
STRIPE_FEE_FIJO=0.3
FEE_STRIPE_REPARTO=compartido
STRIPE_PAYOUT_INTERVAL=monthly
STRIPE_PAYOUT_ANCHOR=1

# ---------------------------------------------------------------- #
# PASARELA DE PAGO  (stripe recomendado)
# ---------------------------------------------------------------- #
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY="sk_live_..."

# Un secreto POR ENDPOINT (Stripe genera uno distinto en cada webhook):
#   Pagos:        https://TU_API/api/reservas/webhook/pago
#                 eventos: payment_intent.succeeded, payment_intent.payment_failed,
#                          payment_intent.canceled
#   Suscripción:  https://TU_API/api/suscripcion/webhook
#                 eventos: invoice.paid, invoice.payment_failed,
#                          customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET_PAGOS="whsec_..."
STRIPE_WEBHOOK_SECRET_SUSCRIPCION="whsec_..."
# Reserva de compatibilidad: si solo defines esta, se usa para los dos endpoints.
# No es lo correcto (Stripe genera un secreto distinto por endpoint), pero evita
# quedarte sin webhooks si solo tienes uno a mano. Déjala vacía si rellenas las dos de arriba.
STRIPE_WEBHOOK_SECRET=""

# Precios recurrentes del SaaS (uno por plan e intervalo).
STRIPE_PRICE_BASICO_MENSUAL="price_..."
STRIPE_PRICE_BASICO_ANUAL="price_..."
STRIPE_PRICE_PRO_MENSUAL="price_..."
STRIPE_PRICE_PRO_ANUAL="price_..."

# --- PayPal (solo si PAYMENT_PROVIDER=paypal) ---
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=""

# ---------------------------------------------------------------- #
# EMAIL (obligatorio: verificación, confirmación, recordatorios)
# ---------------------------------------------------------------- #
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Turno <no-reply@tudominio.com>"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS=""

# ---------------------------------------------------------------- #
# WHATSAPP
# ---------------------------------------------------------------- #
WHATSAPP_PROVIDER=deeplink
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_LANG=es

# ---------------------------------------------------------------- #
# IMÁGENES (en PaaS el disco es efímero: usa s3)
# ---------------------------------------------------------------- #
STORAGE_PROVIDER=s3
UPLOAD_DIR=uploads
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------- #
# ACCESO CON GOOGLE
# ---------------------------------------------------------------- #
GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------- #
# OBSERVABILIDAD (muy recomendable)
# ---------------------------------------------------------------- #
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------- #
# PRIMER SUPERADMIN
# ---------------------------------------------------------------- #
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NOMBRE="Super Admin"

# ---------------------------------------------------------------- #
# EMPRESA
# ---------------------------------------------------------------- #
COMPANY_NAME=""
COMPANY_SUPPORT_EMAIL=""

# ---------------------------------------------------------------- #
# OPCIONALES
# ---------------------------------------------------------------- #
RUBRO_FIJO=""
# Escotilla SOLO para staging: permite arrancar con pagos simulados y emails a
# consola en NODE_ENV=production. Jamás en el entorno real de clientes.
PERMITIR_MODO_DEMO=false

# ---------------------------------------------------------------- #
# SEGUNDO FACTOR (2FA) — recomendado activarlo
# ---------------------------------------------------------------- #
# Clave propia para cifrar los secretos TOTP (si la dejas vacía se deriva de
# JWT_SECRET). Guárdala igual que el resto de secretos: cambiarla obliga a todo
# el mundo a volver a configurar su segundo factor con los códigos de recuperación.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_CLAVE=""
# El panel de superadmin ve TODOS los negocios, usuarios e ingresos.
EXIGIR_2FA_SUPERADMIN="true"

# ---------------------------------------------------------------- #
# IMPUESTOS DE LA SUSCRIPCIÓN
# ---------------------------------------------------------------- #
# Si vendes a clientes de la UE (u otra jurisdicción con IVA), esto no es
# opcional. Actívalo también en el panel de Stripe (Settings → Tax).
# Consulta con tu asesor fiscal qué te aplica.
STRIPE_TAX_ACTIVO="false"

# ---------------------------------------------------------------- #
# LÍMITES DE PETICIONES (por IP)
# ---------------------------------------------------------------- #
# El límite es por IP, y una IP puede ser una oficina entera. Si recibes quejas
# de "me dice demasiadas peticiones", súbelo; si ves abuso, bájalo.
RATE_LIMIT_MAX=1000
RATE_LIMIT_VENTANA_MIN=15
RATE_LIMIT_AUTH_MAX=30

# ---------------------------------------------------------------- #
# LISTA DE ESPERA Y ANALÍTICA
# ---------------------------------------------------------------- #
ESPERA_AVISOS_POR_HUECO=3
# Los eventos del embudo se guardan en tu base de datos (no van a terceros).
# El job de limpieza purga los más antiguos cada día.
ANALITICA_ACTIVA="true"
EVENTOS_RETENCION_DIAS=90
