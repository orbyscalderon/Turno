####################################################################
#  TURNO — BACKEND · PLANTILLA DE DESARROLLO
#  Copia este archivo a `.env` y ajusta lo que necesites.
#  Para producción usa `.env.production.example` (tiene más candados).
####################################################################

# ---------------------------------------------------------------- #
# BASE DE DATOS
# ---------------------------------------------------------------- #
# Conexión de la app. Con Supabase/Neon usa el puerto del POOLER (6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/turno?schema=public"
# Conexión DIRECTA (5432), solo para migraciones. En local es la misma.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/turno?schema=public"

# ---------------------------------------------------------------- #
# SERVIDOR
# ---------------------------------------------------------------- #
PORT=4000
NODE_ENV=development

# URL del frontend: controla CORS y los enlaces de los emails.
# DEBE incluir el esquema (http:// o https://).
FRONTEND_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# ---------------------------------------------------------------- #
# SESIONES
# ---------------------------------------------------------------- #
# En producción: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-secret-cambiar-en-produccion"
# Duración del token de ACCESO. Corto a propósito: un baneo o un cambio de
# contraseña surte efecto en este plazo (el refresh token se revoca al instante).
JWT_EXPIRES_IN="1h"
# Duración del refresh token (días). Rota en cada uso y es revocable.
REFRESH_TOKEN_DIAS=30

# ---------------------------------------------------------------- #
# OPERATIVA DE CITAS
# ---------------------------------------------------------------- #
# Zona horaria por defecto de los negocios nuevos (IANA). Cada negocio puede
# cambiar la suya; de ella dependen huecos, agenda y recordatorios.
TIMEZONE_DEFECTO="Europe/Madrid"
# Minutos que se mantiene bloqueado el hueco esperando el pago.
RESERVA_HOLD_MINUTOS=15
# Horas mínimas de antelación para tener derecho a reembolso al cancelar.
CANCELACION_HORAS_REEMBOLSO=24
# Antelación mínima para poder reservar (0 = se puede reservar para ya mismo).
ANTELACION_MINIMA_HORAS=0
# Hasta cuántos días por delante se puede reservar.
HORIZONTE_RESERVA_DIAS=90
# Reservas sin pagar simultáneas por cliente (evita bloquear agendas gratis).
MAX_RESERVAS_PENDIENTES_POR_CLIENTE=3
# Exigir email confirmado para reservar y crear negocio. En producción: true.
EXIGIR_EMAIL_VERIFICADO=false
# Segundo recordatorio, N horas antes de la cita (0 = desactivado).
RECORDATORIO_CORTO_HORAS=3
# Tope de profesionales por negocio para los planes antiguos (los planes
# actuales mandan: ver backend/src/lib/planes.ts).
MAX_PELUQUEROS_POR_NEGOCIO=5

# ---------------------------------------------------------------- #
# DINERO: FIANZA Y REPARTO
# ---------------------------------------------------------------- #
# Fianza que paga el cliente para confirmar la cita.
FIANZA_RESERVA_USD=2
# Comisión que retiene la plataforma de cada fianza.
FIANZA_COMISION_USD=0.5
# Comisión real de la pasarela (para calcular el reparto exacto).
STRIPE_FEE_PCT=2.9
STRIPE_FEE_FIJO=0.3
# Quién asume la comisión de la pasarela:
#   negocio | plataforma | compartido (50/50) | cliente (se suma a la fianza)
FEE_STRIPE_REPARTO=compartido
# Calendario de depósitos a los negocios (Stripe Connect).
STRIPE_PAYOUT_INTERVAL=monthly
STRIPE_PAYOUT_ANCHOR=1

# ---------------------------------------------------------------- #
# PASARELA DE PAGO
# ---------------------------------------------------------------- #
# mock   = simulado, sin cobrar (SOLO desarrollo)
# stripe = cobro real con tarjeta (Stripe Elements en el frontend)
# paypal = cobro real con PayPal (Orders v2, con redirección)
PAYMENT_PROVIDER=mock

# --- Stripe ---
STRIPE_SECRET_KEY=""
# Stripe da un secreto DISTINTO por endpoint de webhook. Rellena los dos:
#   /api/reservas/webhook/pago   -> STRIPE_WEBHOOK_SECRET_PAGOS
#   /api/suscripcion/webhook     -> STRIPE_WEBHOOK_SECRET_SUSCRIPCION
STRIPE_WEBHOOK_SECRET_PAGOS=""
STRIPE_WEBHOOK_SECRET_SUSCRIPCION=""
# (Compatibilidad: si solo defines este, se usa para los dos.)
STRIPE_WEBHOOK_SECRET=""
# Precios recurrentes del SaaS (price_... creados en el panel de Stripe).
STRIPE_PRICE_BASICO_MENSUAL=""
STRIPE_PRICE_BASICO_ANUAL=""
STRIPE_PRICE_PRO_MENSUAL=""
STRIPE_PRICE_PRO_ANUAL=""

# --- PayPal (alternativa a Stripe) ---
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_MODE=sandbox
# Id del webhook creado en el panel de PayPal (valida la firma de los eventos).
PAYPAL_WEBHOOK_ID=""

# ---------------------------------------------------------------- #
# EMAIL
# ---------------------------------------------------------------- #
# dev  = solo escribe el email en el log (desarrollo)
# smtp = envía de verdad (SendGrid, SES, Mailgun, Postmark...)
EMAIL_TRANSPORT=dev
EMAIL_FROM="Turno <no-reply@turno.app>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------- #
# WHATSAPP
# ---------------------------------------------------------------- #
# deeplink = genera un enlace wa.me que pulsa el usuario (gratis)
# cloud    = envío automático con la Cloud API de Meta (requiere plantilla)
WHATSAPP_PROVIDER=deeplink
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_LANG=es

# ---------------------------------------------------------------- #
# IMÁGENES
# ---------------------------------------------------------------- #
# local = disco (desarrollo o VPS con volumen)
# s3    = Backblaze B2 / Cloudflare R2 / S3 (obligatorio en PaaS efímeros)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=""
S3_REGION=us-east-1
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ---------------------------------------------------------------- #
# ACCESO CON GOOGLE
# ---------------------------------------------------------------- #
# Vacío = el botón de Google queda desactivado.
GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------- #
# OBSERVABILIDAD
# ---------------------------------------------------------------- #
# Vacío = los errores solo van al log estructurado.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------- #
# PRIMER SUPERADMIN (se crea solo al arrancar, una vez)
# ---------------------------------------------------------------- #
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NOMBRE="Super Admin"

# ---------------------------------------------------------------- #
# EMPRESA (pies de email y textos legales)
# ---------------------------------------------------------------- #
COMPANY_NAME="OC HOLDING GROUP LLC"
COMPANY_SUPPORT_EMAIL="soporte@turno.app"

# ---------------------------------------------------------------- #
# MODO DE UN SOLO RUBRO (opcional)
# ---------------------------------------------------------------- #
# Si se define (p. ej. "barberia"), este despliegue solo ofrece ese rubro.
RUBRO_FIJO=""

# ---------------------------------------------------------------- #
# SEGUNDO FACTOR (2FA)
# ---------------------------------------------------------------- #
# Clave para cifrar los secretos TOTP en reposo. Vacía = se deriva de JWT_SECRET.
# OJO: si la cambias, los segundos factores ya configurados dejan de validar y
# habrá que entrar con los códigos de recuperación.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_CLAVE=""
# true exige 2FA a los superadmin para entrar a su panel (recomendado en producción).
EXIGIR_2FA_SUPERADMIN="false"

# ---------------------------------------------------------------- #
# IMPUESTOS DE LA SUSCRIPCIÓN
# ---------------------------------------------------------------- #
# true delega el cálculo de IVA/impuestos en Stripe Tax. Hay que activarlo
# TAMBIÉN en el panel de Stripe (Settings → Tax) o el checkout fallará.
STRIPE_TAX_ACTIVO="false"

# ---------------------------------------------------------------- #
# LÍMITES DE PETICIONES (por IP)
# ---------------------------------------------------------------- #
# Una IP no es una persona: oficinas y redes móviles comparten salida. Con 300
# cada 15 min, varios usuarios detrás del mismo router se quedaban sin servicio.
RATE_LIMIT_MAX=1000
RATE_LIMIT_VENTANA_MIN=15
# Login/registro/reset: estricto a propósito (defensa contra fuerza bruta).
RATE_LIMIT_AUTH_MAX=30

# ---------------------------------------------------------------- #
# LISTA DE ESPERA
# ---------------------------------------------------------------- #
# A cuántos clientes de la cola se avisa por cada hueco liberado.
ESPERA_AVISOS_POR_HUECO=3

# ---------------------------------------------------------------- #
# ANALÍTICA DE PRODUCTO
# ---------------------------------------------------------------- #
# Eventos del embudo. Se guardan en TU base de datos: no se envía nada a terceros.
ANALITICA_ACTIVA="true"
EVENTOS_RETENCION_DIAS=90
